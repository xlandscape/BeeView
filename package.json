{
    "name": "beeview",
    "version": "0.1.0",
    "private": true,
    "dependencies": {
        "@deck.gl/extensions": "^9.2.11",
        "@deck.gl/layers": "^9.2.11",
        "@deck.gl/mapbox": "9.1.11",
        "@reduxjs/toolkit": "^2.8.0",
        "d3-array": "^3.2.4",
        "d3-axis": "^3.0.0",
        "d3-format": "^3.1.2",
        "d3-scale": "^4.0.2",
        "d3-selection": "^3.0.0",
        "d3-shape": "^3.2.0",
        "deck.gl": "^9.0.0",
        "maplibre-gl": "^5.0.0",
        "react": "^18.2.0",
        "react-dom": "^18.2.0",
        "react-map-gl": "^8.0.4",
        "react-redux": "^8.1.1"
    },
    "devDependencies": {
        "@babel/core": "^7.27.1",
        "@babel/preset-env": "^7.27.2",
        "@babel/preset-react": "^7.27.1",
        "@vitejs/plugin-react": "^4.4.1",
        "electron": "^36.2.1",
        "electron-builder": "^26.0.12",
        "vite": "^6.3.5",
        "vite-electron-builder": "^0.0.0"
    },
    "main": "electron/main.js",
    "scripts": {
        "dev": "vite --host 0.0.0.0 --port 8081",
        "electron:dev": "set VITE_DEV_SERVER_URL=http://localhost:3000 && electron .",
        "build": "vite build",
        "electron:build": "electron-builder --dir",
        "electron:dist": "electron-builder",
        "api": "uvicorn ../server/main:app --reload --port 8080"
    },
    "build": {
        "appId": "com.example.beeview",
        "productName": "BeeView",
        "directories": {
            "output": "release"
        },
        "files": [
            "dist/**/*",
            "electron/**/*"
        ],
        "win": {
            "target": "nsis",
            "icon": "public/icon.ico"
        },
        "mac": {
            "target": "dmg",
            "icon": "public/icon.icns"
        },
        "linux": {
            "target": "AppImage",
            "icon": "public/icon.png"
        }
    }
}
