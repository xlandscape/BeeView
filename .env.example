# API Configuration for BeeForage Analysis Frontend
# Copy this file to .env and update values as needed

# API Protocol (http or https)
VITE_API_PROTOCOL=http

# API Host (server hostname or IP address)
VITE_API_HOST=localhost

# API Port (server port number)
VITE_API_PORT=32000

# Example production configuration:
# VITE_API_PROTOCOL=https
# VITE_API_HOST=your-production-server.com
# VITE_API_PORT=443
